# Python (art generator scripts)
__pycache__/
*.py[cod]
.venv/

# Generated from the SVG sources; rebuild with the art scripts
art/**/render/
art/**/states/

# WoW client folders, should the client's tree ever be mirrored here
# (only WoW/Interface/AddOns/ is project code)
WoW/WTF/
WoW/Cache/
WoW/Logs/
WoW/Errors/
WoW/Screenshots/

# AddOns/ holds only the suite's own addons; third-party addons kept here
# for reference (DynamicCam, FrameAnchorUIBuilder, WeakTextures, ...) stay
# out of the repo. Add each new suite member to this whitelist.
WoW/Interface/AddOns/*
!WoW/Interface/AddOns/Medalluin/
