<Bindings>
	<!-- Options > Keybindings > AddOns > Medalluin; Console > Minimap sets it too.
	     The names are in console/minimap.lua. -->
	<Binding name="MEDALLUIN_MINIMAP" header="MEDALLUIN" category="ADDONS">
		MedalluinToggleMinimap()
	</Binding>
	<!-- quests/log.lua: the quest log key's own keys are bound to it while the
	     Quest log option is on -->
	<Binding name="MEDALLUIN_QUESTLOG" category="ADDONS">
		MedalluinToggleQuestLog()
	</Binding>
</Bindings>
